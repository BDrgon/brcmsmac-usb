# Copy to config/local.env (gitignored) and fill in for your setup.
# Scripts source this file; nothing in it is ever committed.

# Target device running the driver (SSH alias or user@host)
TARGET_SSH=pi
TARGET_WORKDIR=/home/youruser/brcmsmac-usb
TARGET_KERNEL=            # leave empty to read `uname -r` from the target

# Optional Windows capture host (USBPcap + vendor driver), for protocol captures
WINCAP_SSH=
WINCAP_DIR=

# User-supplied vendor package (never redistributed)
VENDOR_ZIP=work/WNA3100-SW-V2.2.0.4.zip
FIRMWARE_OUT=work/firmware

# Test networks (WPA2-PSK). Keep real credentials only in local.env.
TEST_SSID=
TEST_PSK=
TEST_CHANNEL=6

# Optional x86 development target (native builds; preferred for kernel work)
DEV_SSH=
DEV_WORKDIR=
DEV_NOTE=
